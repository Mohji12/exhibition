DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_USER=root
DATABASE_PASSWORD=
DATABASE_NAME=exhibition

# Comma-separated origins allowed for CORS (frontend)
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,https://exhibition-mocha-sigma.vercel.app,https://www.conninter.com,https://conninter.com
# Allow Vercel previews and conninter.com (apex + www + subdomains)
CORS_ORIGIN_REGEX=https://(.*\.)?vercel\.app|https://(.*\.)?conninter\.com

AUTH_SECRET=change-me-to-a-long-random-string
AUTH_BOOTSTRAP_EMAIL=admin@conninter.example
AUTH_BOOTSTRAP_PIN=2026
AUTH_BOOTSTRAP_NAME=Conninter Admin

# Card OCR / voice notes (server-side only — never expose in UI)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional email (forgot/reset PIN). Leave empty until wired.
RESEND_API_KEY=
MAIL_FROM=FUNNEL <noreply@conninter.com>
MAIL_ENABLED=false
