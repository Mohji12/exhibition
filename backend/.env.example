DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_USER=root
DATABASE_PASSWORD=
DATABASE_NAME=exhibition

# Comma-separated origins allowed for CORS (frontend)
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,https://exhibition-mocha-sigma.vercel.app
# Allow other Vercel preview/production deployments
CORS_ORIGIN_REGEX=https://.*\.vercel\.app

AUTH_SECRET=change-me-to-a-long-random-string
AUTH_BOOTSTRAP_EMAIL=admin@conninter.example
AUTH_BOOTSTRAP_PIN=2026
AUTH_BOOTSTRAP_NAME=Conninter Admin

# Google Gemini (card OCR / validation) — server-side only
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
