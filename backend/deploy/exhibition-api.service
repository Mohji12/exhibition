[Unit]
Description=Conninter Visitor Book API
After=network.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/conninter-exhibition/backend
Environment=PATH=/home/ubuntu/conninter-exhibition/backend/.venv/bin
ExecStart=/home/ubuntu/conninter-exhibition/backend/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
